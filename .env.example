# Play-Stream backend environment
# Copy to .env and fill in. NEVER commit a real .env.

# MySQL connection — REQUIRED for the self-hosted catalog.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=beatnest
DB_PASSWORD=change_me
DB_NAME=beatnest

# JWT signing secret — REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the API listens on (default 4000)
# PORT=4000

# Comma-separated list of origins allowed by CORS.
# Defaults to permissive (development). Example:
# CORS_ORIGINS=https://beatnest.example.com

# ── Cloudflare R2 object storage (optional) ───────────────────────
# When set, new audio/cover uploads go to R2 instead of local disk and are
# referenced by public URL. The bucket must allow public read (r2.dev public
# access or a custom domain) and a CORS rule for your app origin(s).
#
# R2_API_TOKEN=  # optional: if set, scripts can read the account ID from here
# R2_ACCOUNT_ID=your_cf_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=beatnest-music
# R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXX.r2.dev  # or your custom domain
# R2_REGION=auto  # region override if your bucket isn't 'auto'